# Copy this file to .env (local dev) and/or set these as GitHub repo secrets
# (Settings → Secrets and variables → Actions) for the Pages build.
# See README.md → "Smart entry (AI parsing)" for the full setup.

# URL of the deployed parse microservice (Vercel Function, /api/parse).
VITE_PARSE_ENDPOINT=https://<your-vercel-project>.vercel.app/api/parse

# Shared secret; must match BUDGET_PARSE_SECRET set on the Vercel project.
VITE_PARSE_SECRET=change-me
