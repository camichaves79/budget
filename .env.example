# Copy this file to .env (local dev) and/or set these as GitHub repo secrets
# (Settings → Secrets and variables → Actions) for the Pages build.
# Full setup checklist (Firebase project, Lemon Squeezy store, Vercel env):
# see skills/paywall-ops.md.

# --- Environment label (env separation, 2026-09) ---
# Renders a small badge in the app corner + a suffix in Settings → About.
# Set it to `staging` in the Pages **Preview** environment and leave it UNSET
# in Production (absent / blank / `production` all mean "no badge").
VITE_ENV_LABEL=

# --- Smart entry (AI parsing) ---
# URL of the deployed parse microservice (Vercel Function, /api/parse).
VITE_PARSE_ENDPOINT=https://<your-vercel-project>.vercel.app/api/parse

# Shared secret; must match BUDGET_PARSE_SECRET set on the Vercel project.
VITE_PARSE_SECRET=change-me

# --- License / paywall endpoints (same Vercel project) ---
# Base URL used for /api/license/* calls.
VITE_API_BASE=https://<your-vercel-project>.vercel.app

# --- Firebase Auth (Google sign-in; Apple later) ---
# Project settings → General → Your apps → Web app (all public by design).
VITE_FIREBASE_API_KEY=change-me
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project>
VITE_FIREBASE_APP_ID=change-me

# --- Lemon Squeezy checkout (buy link for the $5/year license) ---
# The store's checkout URL; the app appends embed/theme params and opens the
# overlay. Configure the success redirect in the LS dashboard (see
# skills/paywall-ops.md for the exact placeholders).
VITE_CHECKOUT_URL=https://<store>.lemonsqueezy.com/checkout/buy/<uuid>

# --- Google Play Billing (Android / Trusted Web Activity) ---
# The Play subscription productId (Play Console → Monetize → Subscriptions).
# Only used inside the Play build (TWA); the web/iOS builds ignore it.
VITE_PLAY_SUBSCRIPTION_ID=smart_entry_yearly

# Server-only vars (Vercel project env, never in the client bundle or Pages
# secrets):
#   GEMINI_API_KEY, BUDGET_PARSE_SECRET, GEMINI_FALLBACK_MODEL (existing)
#   BUDGET_LICENSE_SECRET      # HMAC key that signs license tokens
#   LEMONSQUEEZY_API_KEY       # LS API key (server-side only)
#   LEMONSQUEEZY_WEBHOOK_SECRET# LS webhook signing secret
#   LEMONSQUEEZY_STORE_ID      # LS store id (webhook payload verification)
#   FIREBASE_SERVICE_ACCOUNT   # service-account JSON, single line
#   BUDGET_ADMIN_SECRET        # protects /api/ledger/export (x-budget-admin)
#   LICENSE_DAILY_CAP          # optional, default 100 parses/day per license
#   GOOGLE_PLAY_SERVICE_ACCOUNT # Play Developer API service-account JSON (single line)
#   GOOGLE_PLAY_PACKAGE_NAME   # app.fivebudget
#   GOOGLE_PLAY_SUBSCRIPTION_ID # the Play subscription productId (optional validation)
#   GOOGLE_PLAY_PUBSUB_AUDIENCE # optional: the push endpoint URL (defaults to host+path)
#   GOOGLE_PLAY_PUBSUB_EMAIL    # optional: pin the Pub/Sub push service-account email
